# ==========================================
# ЭТАП 1: Сборка (Builder)
# ==========================================
# Берем тяжелый образ с Node.js (он весит почти 1 ГБ, нужен только для сборки)
FROM node:18-alpine AS builder

# Задаем рабочую папку
WORKDIR /app

# Копируем списки зависимостей и устанавливаем их (кэширование, как в Питоне!)
COPY package.json package-lock.json* ./
RUN npm install

# Копируем весь остальной код фронтенда
COPY . .

# Собираем готовый статический сайт (HTML, CSS, JS) в папку /app/build (или /app/dist)
RUN npm run build

# ==========================================
# ЭТАП 2: Раздача (Production)
# ==========================================
# Берем супер-легкий образ Nginx (весит около 20 МБ!)
FROM nginx:alpine

# КОЗЫРЬ: Копируем ТОЛЬКО готовые файлы из первого этапа (builder)
# Тяжелый Node.js и исходники остаются в прошлом и удаляются, образ получается крошечным!
COPY --from=builder /app/build /usr/share/nginx/html

# Открываем 80 порт внутри контейнера
EXPOSE 80

# Запускаем Nginx
CMD ["nginx", "-g", "daemon off;"]