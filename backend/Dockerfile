# 1. Берем официальный и ЛЕГКИЙ образ Python (slim весит мало)
FROM python:3.10-slim

# 2. Указываем рабочую папку ВНУТРИ контейнера
WORKDIR /app

# 3. КОЗЫРЬ ДЛЯ СОБЕСЕДОВАНИЯ: Копируем СНАЧАЛА только requirements.txt
COPY requirements.txt .

# 4. Устанавливаем библиотеки (флаг --no-cache-dir нужен, чтобы образ весил еще меньше)
RUN pip install --no-cache-dir -r requirements.txt

# 5. И только ТЕПЕРЬ копируем весь остальной наш код в контейнер
COPY . .

# 6. Документируем порт, который слушает наше приложение
EXPOSE 8000

# 7. Команда запуска FastAPI сервера
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]